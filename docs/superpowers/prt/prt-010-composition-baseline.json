{
  "$comment": "PRT-010 DSH 组合分层与 Legion 挂载基线。由 scripts/prt/composition-baseline.mjs 生成。**不含 config 值、不含绝对路径、不含时间戳**：契约是「有哪些行、每行配了哪些键」，不是「某台机器上配了什么」。",
  "version": 1,
  "profile": "web",
  "profileRootIsEmptyList": true,
  "bundles": [
    "@deepseek-ai/dsh-base",
    "@deepseek-ai/dsh-web-app"
  ],
  "patchReload": "live",
  "layers": [
    {
      "order": 1,
      "layer": "dsh-base",
      "source": "packages/bundle/base/cordis.patch.yml",
      "kind": "insert"
    },
    {
      "order": 2,
      "layer": "@deepseek-ai/dsh-web-app",
      "source": "packages/bundle/web-app/cordis.patch.yml",
      "kind": "patch-over"
    },
    {
      "order": 3,
      "layer": "用户 profile 层",
      "source": "profiles/<profile>/cordis.patch.yml",
      "kind": "patch-over"
    }
  ],
  "legionRows": [
    {
      "id": "legion-mediator",
      "package": "@dsh-external/dsh-scrum-worker",
      "repoDir": "plugins",
      "configKeys": [
        "agentPreset",
        "denyTools",
        "hubToken",
        "hubUrl",
        "intervalMs",
        "isolate",
        "logFile",
        "maxWorkers",
        "mode",
        "provider",
        "repoRoot",
        "role",
        "rolesFile",
        "scope",
        "scrumDir",
        "staleMinutes",
        "workerTimeoutMs",
        "workspace",
        "worktreeRoot"
      ],
      "emptyConfigKeys": [
        "denyTools",
        "hubToken",
        "rolesFile",
        "worktreeRoot"
      ]
    },
    {
      "id": "legion-scrum-board",
      "package": "@dsh-external/dsh-scrum-board",
