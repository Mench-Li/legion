diff --git a/packages/subagent/subagent-claude-code/src/events.ts b/packages/subagent/subagent-claude-code/src/events.ts
new file mode 100644
index 0000000000..ab87264a5e
--- /dev/null
+++ b/packages/subagent/subagent-claude-code/src/events.ts
@@ -0,0 +1,81 @@
+/**
+ * Map provider-observed Claude Code SDK messages onto the subagent seam's
+ * progress events. Only facts the SDK actually reports are emitted: tool
+ * requests/results and usage. Assistant prose is already delivered as the final
+ * output, and streaming deltas are deliberately not duplicated into the event
+ * stream (volume without actionable content).
+ *
+ * @module @deepseek-ai/dsh-subagent-claude-code/events
+ */
+import type { RunEvent } from './run-events.ts'
+
+interface ClaudeUsage {
+  input_tokens?: unknown
+  output_tokens?: unknown
+}
+
+interface ClaudeBlock {
+  type?: unknown
+  name?: unknown
+  id?: unknown
+  tool_use_id?: unknown
+  is_error?: unknown
+}
+
+interface ClaudeMessage {
+  type?: unknown
+  message?: { content?: unknown }
+  usage?: ClaudeUsage
+}
+
+/** Translate one SDK message into zero or more seam events. */
+export function claudeMessageEvents(raw: unknown): RunEvent[] {
+  if (raw === null || typeof raw !== 'object') return []
+  const message = raw as ClaudeMessage
+  const events: RunEvent[] = []
+  if (message.type === 'assistant') {
+    const content = message.message?.content
+    if (Array.isArray(content)) {
+      for (const block of content as ClaudeBlock[]) {
+        if (block === null || typeof block !== 'object') continue
+        if (block.type !== 'tool_use' || typeof block.name !== 'string') continue
+        events.push({
+          type: 'tool.requested',
+          toolName: block.name,
+          ...(typeof block.id === 'string' ? { toolId: block.id } : {}),
+        })
+      }
+    }
+    return events
+  }
+  if (message.type === 'user') {
+    const content = message.message?.content
+    if (Array.isArray(content)) {
+      for (const block of content as ClaudeBlock[]) {
+        if (block === null || typeof block !== 'object') continue
+        if (block.type !== 'tool_result' || typeof block.tool_use_id !== 'string') continue
+        events.push({
+          type: block.is_error === true ? 'tool.failed' : 'tool.completed',
+          toolId: block.tool_use_id,
+        })
+      }
+    }
+    return events
+  }
+  if (message.type === 'result') {
+    const usage = message.usage
+    if (usage !== undefined && usage !== null && typeof usage === 'object') {
+      const inputTokens = typeof usage.input_tokens === 'number' ? usage.input_tokens : undefined
+      const outputTokens = typeof usage.output_tokens === 'number' ? usage.output_tokens : undefined
+      if (inputTokens !== undefined || outputTokens !== undefined) {
+        events.push({
+          type: 'usage.updated',
+          ...(inputTokens === undefined ? {} : { inputTokens }),
+          ...(outputTokens === undefined ? {} : { outputTokens }),
+        })
+      }
+    }
+    return events
+  }
+  return events
+}
diff --git a/packages/subagent/subagent-claude-code/src/run-events.ts b/packages/subagent/subagent-claude-code/src/run-events.ts
new file mode 100644
index 0000000000..4b8fab8e78
--- /dev/null
+++ b/packages/subagent/subagent-claude-code/src/run-events.ts
@@ -0,0 +1,79 @@
+/**
+ * Provider-local bounded event stream.
+ *
+ * Why this is duplicated in both out-of-process providers: the seam's core
+ * package (`@deepseek-ai/dsh-subagent`) ships inside the host's app.asar and is
+ * not a profile-installable package, so a Legion compat patch cannot change it.
+ * Keeping the bridge local lets each provider expose `run.events` without a core
+ * patch. Keep the two copies in step; the tests pin the observable behaviour.
+ *
+ * @module @deepseek-ai/dsh-subagent-claude-code/run-events
+ */
+/** One provider-observed progress event. */
+export interface RunEvent {
+  /** Discriminator; consumers map it onto their own vocabulary. */
+  readonly type: string
+  readonly [key: string]: unknown
+}
+
+/** Options for {@link createRunEventStream}. */
+export interface RunEventStreamOptions {
+  /** Maximum buffered events before the oldest is dropped. Defaults to 1000. */
+  readonly limit?: number
+}
+
+/** A bounded push-to-async-iterable bridge for provider-observed events. */
+export interface RunEventStream {
+  /** The iterable a consumer reads; ends when {@link close} is called and drained. */
+  readonly events: AsyncIterable<RunEvent>
+  /** Append one observed event. No-op after close. */
+  push(event: RunEvent): void
+  /** End the iterable after the buffered events are drained. Idempotent. */
+  close(): void
+}
+
+/** Create a bounded event stream. */
+export function createRunEventStream(options: RunEventStreamOptions = {}): RunEventStream {
+  const limit = options.limit ?? 1000
+  if (!Number.isSafeInteger(limit) || limit <= 0) throw new TypeError('run event stream limit must be a positive integer')
+  const buffer: RunEvent[] = []
+  let dropped = 0
+  let closed = false
+  let wake: (() => void) | undefined
+  const notify = (): void => {
+    const resume = wake
+    wake = undefined
+    resume?.()
+  }
+  const events = (async function* (): AsyncGenerator<RunEvent> {
+    for (;;) {
+      const next = buffer.shift()
+      if (next !== undefined) {
+        yield next
+        continue
+      }
+      if (closed) break
+      await new Promise<void>((resolve) => { wake = resolve })
+    }
+    // The consumer learns the timeline is incomplete instead of inferring
+    // "nothing else happened".
+    if (dropped > 0) yield { type: 'run.progress', droppedEvents: dropped }
+  })()
+  return {
+    events,
+    push(event: RunEvent): void {
+      if (closed) return
+      if (buffer.length >= limit) {
+        buffer.shift()
+        dropped += 1
+      }
+      buffer.push(event)
+      notify()
+    },
+    close(): void {
+      if (closed) return
+      closed = true
+      notify()
+    },
+  }
+}
