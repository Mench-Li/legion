diff --git a/packages/subagent/subagent-claude-code/tests/events.spec.ts b/packages/subagent/subagent-claude-code/tests/events.spec.ts
new file mode 100644
index 0000000000..9e50a391d7
--- /dev/null
+++ b/packages/subagent/subagent-claude-code/tests/events.spec.ts
@@ -0,0 +1,45 @@
+import { describe, expect, it } from 'vitest'
+import { claudeMessageEvents } from '../src/events.ts'
+
+describe('claudeMessageEvents', () => {
+  it('maps assistant tool_use blocks to tool.requested', () => {
+    const events = claudeMessageEvents({
+      type: 'assistant',
+      message: {
+        content: [
+          { type: 'text', text: 'working' },
+          { type: 'tool_use', id: 'tool-1', name: 'Bash', input: { command: 'ls' } },
+        ],
+      },
+    })
+    expect(events).toEqual([{ type: 'tool.requested', toolName: 'Bash', toolId: 'tool-1' }])
+  })
+
+  it('maps user tool_result blocks to completed/failed', () => {
+    const events = claudeMessageEvents({
+      type: 'user',
+      message: {
+        content: [
+          { type: 'tool_result', tool_use_id: 'tool-1', is_error: false },
+          { type: 'tool_result', tool_use_id: 'tool-2', is_error: true },
+        ],
+      },
+    })
+    expect(events).toEqual([
+      { type: 'tool.completed', toolId: 'tool-1' },
+      { type: 'tool.failed', toolId: 'tool-2' },
+    ])
+  })
+
+  it('maps result usage to usage.updated and ignores non-numeric fields', () => {
+    expect(claudeMessageEvents({ type: 'result', usage: { input_tokens: 12, output_tokens: 3 } }))
+      .toEqual([{ type: 'usage.updated', inputTokens: 12, outputTokens: 3 }])
+    expect(claudeMessageEvents({ type: 'result', usage: { input_tokens: 'x' } })).toEqual([])
+  })
+
+  it('returns no events for unobserved message kinds or garbage', () => {
+    expect(claudeMessageEvents({ type: 'stream_event' })).toEqual([])
+    expect(claudeMessageEvents(null)).toEqual([])
+    expect(claudeMessageEvents({ type: 'assistant', message: { content: 'text' } })).toEqual([])
+  })
+})
