       if (this.recordDeclinedItem(item, order)) return
       if (item.type !== 'agentMessage') return
       const text = typeof item.text === 'string'
@@ -708,4 +711,23 @@ export class CodexAppServerWire {
       order: order ?? this.nextObservationOrder(),
     })
   }
+
+  /**
+   * Publish one tool item's terminal fact. Other item kinds (agent messages)
+   * are not progress events; the app-server's own status is the only authority
+   * for whether the tool succeeded.
+   */
+  private publishItemEvent(item: JsonObject): void {
+    if (this.onEvent === undefined) return
+    const type = item.type
+    if (type !== 'commandExecution' && type !== 'fileChange' && type !== 'mcpToolCall' && type !== 'webSearch') return
+    const status = typeof item.status === 'string' ? item.status : undefined
+    const failed = status === 'failed' || status === 'declined'
+    this.onEvent({
+      type: failed ? 'tool.failed' : 'tool.completed',
+      toolName: type,
+      ...(typeof item.id === 'string' ? { toolId: item.id } : {}),
+      ...(status === undefined ? {} : { status }),
+    })
+  }
 }
