@@ -0,0 +1,77 @@
+/**
+ * Provider-local bounded event stream.
+ *
+ * Why this is duplicated in both out-of-process providers: the seam's core
+ * package (`@deepseek-ai/dsh-subagent`) ships inside the host's app.asar and is
+ * not a profile-installable package, so a Legion compat patch cannot change it.
+ * Keeping the bridge local lets each provider expose `run.events` without a core
+ * patch. Keep the two copies in step; the tests pin the observable behaviour.
+ *
+ * @module @deepseek-ai/dsh-subagent-codex/run-events
+ */
+/** One provider-observed progress event. */
+export interface RunEvent {
+  /** Discriminator; consumers map it onto their own vocabulary. */
+  readonly type: string
+  readonly [key: string]: unknown
+}
+
+/** Options for {@link createRunEventStream}. */
+export interface RunEventStreamOptions {
+  /** Maximum buffered events before the oldest is dropped. Defaults to 1000. */
+  readonly limit?: number
+}
+
+/** A bounded push-to-async-iterable bridge for provider-observed events. */
+export interface RunEventStream {
+  /** The iterable a consumer reads; ends when {@link close} is called and drained. */
+  readonly events: AsyncIterable<RunEvent>
+  /** Append one observed event. No-op after close. */
+  push(event: RunEvent): void
+  /** End the iterable after the buffered events are drained. Idempotent. */
+  close(): void
+}
+
+/** Create a bounded event stream. */
+export function createRunEventStream(options: RunEventStreamOptions = {}): RunEventStream {
+  const limit = options.limit ?? 1000
+  if (!Number.isSafeInteger(limit) || limit <= 0) throw new TypeError('run event stream limit must be a positive integer')
+  const buffer: RunEvent[] = []
+  let dropped = 0
+  let closed = false
+  let wake: (() => void) | undefined
+  const notify = (): void => {
+    const resume = wake
+    wake = undefined
+    resume?.()
+  }
+  const events = (async function* (): AsyncGenerator<RunEvent> {
+    for (;;) {
+      const next = buffer.shift()
+      if (next !== undefined) {
+        yield next
+        continue
+      }
+      if (closed) break
+      await new Promise<void>((resolve) => { wake = resolve })
+    }
+    if (dropped > 0) yield { type: 'run.progress', droppedEvents: dropped }
+  })()
+  return {
+    events,
+    push(event: RunEvent): void {
+      if (closed) return
+      if (buffer.length >= limit) {
+        buffer.shift()
+        dropped += 1
+      }
+      buffer.push(event)
+      notify()
+    },
+    close(): void {
+      if (closed) return
+      closed = true
+      notify()
+    },
+  }
+}
