# 含已知错误的配置（CI 用夹具）——
# `node scripts/config/check.mjs --env-file=scripts/config/fixtures/bad.env --isolated-env` 必须 FAIL。
# 用于验证「校验器真的会拦」，而不是永远 PASS。
#
# 期望 error（4 条，另有 2 条由非法值触发）：
#   DSH_WORKBENCH_PORT 非法            ← 非整数（非法值报错并回退默认值，不静默接受）
#   WB_MAX_CONNECTIONS 非法            ← 同上
#   NORMS_GLOBAL_MAX 非法              ← 同上（P3-4 插件族）
#   port_conflict                     ← team-hub 5173 与 workbench（回退默认 5173）撞车
#   hub_upstream_port_mismatch        ← 上游 9999 与 hub 实际 5173 不一致
#   exposed_without_token             ← whiteboard 监听 0.0.0.0 却未配 token
# 期望 warning（6 条）：
#   static_root_missing、db_inside_rooms_dir、workbench_token_unset、
#   ctx_digest_over_total、ctx_file_cap_over_total（plugins 的 schema 规则）、
#   services_inject_overrides_env（托管启动会把 team-hub 端口注入回 8787，环境里的 5173 不生效）
#
# 说明：token 相关规则（hub_token_mismatch / hub_token_missing_in_workbench）在**单份环境**里
# 无法触发——因为两个进程读的是同一个 TEAM_HUB_TOKEN。它们针对的是「两进程分别在不同 shell/配置下
# 启动」的真实情形，因此由单元测试直接构造两份配置来覆盖（见 scripts/config/config.test.mjs）。
TEAM_HUB_PORT=5173
TEAM_HUB_HOST=127.0.0.1
TEAM_HUB_TOKEN=hub-token-A
TEAM_HUB_DB=team-hub/team.db
# 非法类型：端口不是数字
DSH_WORKBENCH_PORT=not-a-port
DSH_WORKBENCH_HOST=127.0.0.1
DSH_HUB_UPSTREAM=http://127.0.0.1:9999
DSH_WORKBENCH_ROOT=workbench/dist-does-not-exist

PORT=8080
HOST=0.0.0.0
WB_ROOMS_DIR=data/rooms
DB_PATH=data/rooms/whiteboard.db
WB_MAX_CONNECTIONS=abc

# P3-4 插件族：非法值 + 预算包含关系被破坏（规则违反只提示，非法值则报错并回退默认值）
NORMS_GLOBAL_MAX=abc
CHAT_CTX_BUDGET_CHARS=1000
CHAT_CTX_DIGEST_BUDGET_CHARS=5000
