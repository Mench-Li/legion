# 一致的本地自托管配置（CI 用夹具）——
# `node scripts/config/check.mjs --env-file=scripts/config/fixtures/good.env --isolated-env --strict` 必须 PASS。
# 用途：在不受当前 shell/宿主会话变量影响的前提下，验证 schema 与跨进程规则本身。
TEAM_HUB_PORT=8787
TEAM_HUB_HOST=127.0.0.1
TEAM_HUB_TOKEN=fixture-hub-token
TEAM_HUB_DB=team-hub/team.db

DSH_WORKBENCH_PORT=5173
DSH_WORKBENCH_HOST=127.0.0.1
DSH_WORKBENCH_TOKEN=fixture-wb-token
DSH_HUB_UPSTREAM=http://127.0.0.1:8787
# 指向任何**确实存在**的目录即可（本夹具只验证「静态根存在」这一条规则；
# 真实部署应指向 workbench/dist，产物缺失会得到 static_root_missing 警告）
DSH_WORKBENCH_ROOT=workbench

PORT=8080
HOST=127.0.0.1
WHITEBOARD_TOKEN=fixture-board-token
WHITEBOARD_ROOMS=main:fixture-room-token:rw
WB_ROOMS_DIR=apps/server/data/rooms
WB_AUDIT_DIR=apps/server/data
DB_PATH=apps/server/data/whiteboard.db
